    <script><![CDATA[(function() { data.categories = [];
  try { var catMap = {}; var gr = new GlideRecord("x_1433041_identi_0_template"); gr.addQuery("active", true); gr.setLimit(200); gr.query();
    while (gr.next()) { var cat = gr.getValue("category") || "Uncategorized"; catMap[cat] = (catMap[cat] || 0) + 1; }
    for (var k in catMap) data.categories.push({ name: k, count: catMap[k] });
  } catch (e) { gs.error("IBAR Template Categories widget error: " + e.message); }
})();
]]></script>
    <servicenow>false</servicenow>
    <template><![CDATA[<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><span class="glyphicon glyphicon-tags"></span> Categories</h3></div><div class="panel-body">
  <div class="list-group" ng-if="c.data.categories.length > 0"><div class="list-group-item" ng-repeat="cat in c.data.categories track by $index"><span class="badge">{{cat.count}}</span> {{cat.name}}</div></div>
  <p class="text-muted text-center" ng-if="c.data.categories.length === 0">No categories defined.</p></div></div>
]]></template>
