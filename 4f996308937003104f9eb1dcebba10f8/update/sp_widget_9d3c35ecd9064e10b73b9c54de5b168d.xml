        <template><![CDATA[<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><span class="glyphicon glyphicon-th-list"></span> Section Review</h3></div>
  <div class="panel-body" ng-if="c.data.sections.length > 0"><div class="panel panel-default" ng-repeat="section in c.data.sections track by section.sys_id"><div class="panel-heading"><h4 class="panel-title">{{section.name}} <span class="badge">{{section.responses.length}}</span></h4></div><div class="panel-body"><table class="table table-striped"><thead><tr><th>Question</th><th>Response</th></tr></thead><tbody><tr ng-repeat="r in section.responses track by r.sys_id"><td>{{r.question}}</td><td>{{r.value}}</td></tr></tbody></table></div></div></div>
