        <script><![CDATA[(function() { data.sections = []; data.applicationId = $sp.getParameter("app_id") || ""; try { if (!data.applicationId) return; var respGr = new GlideRecord("x_1433041_identi_0_response"); respGr.addQuery("application", data.applicationId); respGr.orderBy("section"); respGr.setLimit(200); respGr.query(); var sMap = {}; while (respGr.next()) { var sId = respGr.getValue("section"); if (!sMap[sId]) sMap[sId] = { name: respGr.getDisplayValue("section"), responses: [] }; sMap[sId].responses.push({ question: respGr.getDisplayValue("question"), value: respGr.getValue("value") || "(Not answered)", sys_id: respGr.getValue("sys_id") }); } for (var k in sMap) { sMap[k].sys_id = k; data.sections.push(sMap[k]); } } catch (e) { gs.error("IBAR Section Review widget error: " + e.message); } })();
]]></script>
