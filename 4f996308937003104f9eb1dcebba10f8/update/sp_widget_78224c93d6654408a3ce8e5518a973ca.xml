    <roles/>
    <script><![CDATA[(function() { data.summary = { total: 0, info: 0, warning: 0, critical: 0 }; try { var gr = new GlideRecord("x_1433041_identi_0_audit_event"); gr.setLimit(200); gr.query(); while (gr.next()) { data.summary.total++; var sev = gr.getValue("severity"); if (sev === "warning") data.summary.warning++; else if (sev === "critical") data.summary.critical++; else data.summary.info++; } } catch (e) { gs.error("IBAR Audit Summary widget error: " + e.message); } })();
]]></script>
    <servicenow>false</servicenow>
    <template><![CDATA[<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><span class="glyphicon glyphicon-eye-open"></span> Audit Summary</h3></div><div class="panel-body"><div class="row">
