        <template><![CDATA[<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><span class="glyphicon glyphicon-time"></span> Activity Timeline</h3></div>
  <div class="panel-body" ng-if="c.data.events.length > 0"><div class="list-group"><div class="list-group-item" ng-repeat="event in c.data.events track by event.sys_id"><span class="label" ng-class="{'label-info': event.severity === 'info', 'label-warning': event.severity === 'warning', 'label-danger': event.severity === 'critical'}">{{event.event_type}}</span> {{event.description}} <span class="pull-right text-muted"><small>{{event.performed_by}} &middot; {{event.performed_at}}</small></span></div></div></div>
