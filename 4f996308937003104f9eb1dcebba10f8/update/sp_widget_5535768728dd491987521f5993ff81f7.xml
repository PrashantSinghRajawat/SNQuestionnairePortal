        <script><![CDATA[(function() { data.events = []; data.applicationId = $sp.getParameter("app_id") || ""; try { var gr = new GlideRecord("x_1433041_identi_0_audit_event"); if (data.applicationId) gr.addQuery("application", data.applicationId); else gr.addQuery("performed_by", gs.getUserID()); gr.orderByDesc("performed_at"); gr.setLimit(30); gr.query(); while (gr.next()) { data.events.push({ sys_id: gr.getValue("sys_id"), event_type: gr.getDisplayValue("event_type"), description: gr.getValue("description"), performed_by: gr.getDisplayValue("performed_by"), performed_at: gr.getDisplayValue("performed_at"), severity: gr.getValue("severity") }); } } catch (e) { gs.error("IBAR Activity Timeline widget error: " + e.message); } })();
