        <script><![CDATA[(function() { data.versions = []; data.templateId = $sp.getParameter("template_id") || "";
  try { if (!data.templateId) return; var gr = new GlideRecord("x_1433041_identi_0_audit_event"); gr.addQuery("application.template", data.templateId); gr.addQuery("event_type", "template_updated"); gr.orderByDesc("performed_at"); gr.setLimit(20); gr.query();
    while (gr.next()) { data.versions.push({ sys_id: gr.getValue("sys_id"), description: gr.getValue("description"), performed_by: gr.getDisplayValue("performed_by"), performed_at: gr.getDisplayValue("performed_at") }); }
  } catch (e) { gs.error("IBAR Version History widget error: " + e.message); }
})();
]]></script>
