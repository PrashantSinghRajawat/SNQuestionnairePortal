        <script><![CDATA[(function() { data.developers = [];
  try { var gr = new GlideRecord("x_1433041_identi_0_assignment"); gr.addQuery("role", "developer"); gr.addQuery("active", true); gr.setLimit(50); gr.query();
    var devMap = {};
    while (gr.next()) { var uid = gr.getValue("user"); if (!devMap[uid]) devMap[uid] = { user: gr.getDisplayValue("user"), count: 0 }; devMap[uid].count++; }
    for (var k in devMap) data.developers.push(devMap[k]);
  } catch (e) { gs.error("IBAR Build Assignment widget error: " + e.message); }
})();
]]></script>
