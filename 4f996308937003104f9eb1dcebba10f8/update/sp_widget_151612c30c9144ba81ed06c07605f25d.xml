    <tbody><tr ng-repeat="b in c.data.builds track by b.sys_id"><td><strong>{{b.name}}</strong></td><td>{{b.client}}</td><td><span class="label label-info">{{b.application_type}}</span></td><td>{{b.assigned_owner}}</td><td class="text-muted">{{b.updated}}</td></tr></tbody></table></div>
  <div class="panel-body text-center" ng-if="c.data.builds.length === 0"><span class="glyphicon glyphicon-inbox" style="font-size:48px;opacity:0.35"></span><p class="text-muted">No applications in build queue.</p></div></div>
